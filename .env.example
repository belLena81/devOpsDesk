# Copy to .env (git-ignored). Real environment variables override this file.

HTTP_ADDR=:8080
# Matches docker-compose.yml.
DATABASE_URL=postgres://devopsdesk:devopsdesk@localhost:5432/devopsdesk?sslmode=disable

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h

# GitHub sign-in (optional; disabled when GITHUB_CLIENT_ID is empty).
# Create an OAuth App at https://github.com/settings/developers with the
# callback URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback
# Where to send the browser with #token=... after GitHub sign-in.
# Leave empty to get the token as JSON from the callback instead.
OAUTH_SUCCESS_REDIRECT=
# Set to true when served over HTTPS.
COOKIE_SECURE=false
